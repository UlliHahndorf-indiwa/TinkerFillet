<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- Shared settings live in Directory.Build.props. -->
  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>

    <!-- Required by [JSImport]: the generated marshalling code is unsafe (SYSLIB1074). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      Drops the ICU data from the download. The application shows numbers and
      millimetres, never locale-dependent text, so there is nothing to lose and
      several megabytes to save.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TinkerFillet.Core\TinkerFillet.Core.csproj" />
  </ItemGroup>

</Project>
