@* Covers the viewport while the model is being worked out.

   It says which step is running rather than guessing at a percentage. The
   steps are not equal shares of the work - which one dominates depends on the
   model - so a bar filling smoothly would be a fiction. What the user needs to
   know is that something is happening and roughly how far along it is. *@

@if (Visible)
{
    <div class="working" role="status" aria-live="polite">
        <div class="working-card">
            <div class="working-spinner" aria-hidden="true"></div>
            <div class="working-text">
                <strong>@Message</strong>
                @if (Steps > 0)
                {
                    <span class="working-step">Schritt @Step von @Steps</span>
                    <div class="working-track">
                        <div class="working-fill" style="width: @Percent%"></div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string Message { get; set; } = "";

    /// <summary>The step now running, counting from one.</summary>
    [Parameter] public int Step { get; set; }

    /// <summary>How many steps there are, or zero when the work is one lump.</summary>
    [Parameter] public int Steps { get; set; }

    // Reports the step as finished only once it is, so the bar never claims
    // more than has happened.
    private int Percent => Steps <= 0 ? 0 : (int)Math.Round(100.0 * (Step - 1) / Steps);
}
