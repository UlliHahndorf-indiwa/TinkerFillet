<div class="panel">
    <div class="panel-head">
        <span>Verrundungen</span>
        <div class="panel-actions">
            <button title="Rückgängig (Strg+Z)" disabled="@(!CanUndo)" @onclick="Undo">↶</button>
            <button title="Wiederholen (Strg+Umschalt+Z)" disabled="@(!CanRedo)" @onclick="Redo">↷</button>
        </div>
    </div>

    @if (Features.Count == 0)
    {
        <p class="hint">Noch keine. Klicke im Modell auf eine Kante.</p>
    }

    <ul class="features">
        @for (int index = 0; index < Features.Count; index++)
        {
            FilletFeature feature = Features[index];

            <li class="@(feature.Status == FeatureStatus.Failed ? "failed" : null)">
                <span class="number">@(index + 1)</span>

                <label>
                    <input type="text" inputmode="decimal" value="@TextFor(feature)"
                           title="Komma oder Punkt. Pfeiltasten ändern um 0,5 mm, Eingabe übernimmt."
                           @onkeydown="@(e => OnKey(feature, e))"
                           @onchange="@(e => Commit(feature, e.Value?.ToString()))" />
                    mm
                </label>

                @if (feature.Status == FeatureStatus.Failed)
                {
                    <span class="badge" title="Die Kante ist nicht mehr auffindbar oder der Radius passt nicht mehr. Kante erneut anklicken.">fehlgeschlagen</span>
                }

                <button class="remove" title="Entfernen" @onclick="@(() => Remove.InvokeAsync(feature.Id))">✕</button>
            </li>
        }
    </ul>
</div>
