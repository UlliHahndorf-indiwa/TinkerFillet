@if (Visible)
{
    <div class="overlay" @onclick="Cancel">
        <div class="dialog" @onclick:stopPropagation="true">
            <h2>Kante verrunden</h2>
            <p class="hint">@SegmentCount Segment(e) ausgewählt, orange hervorgehoben.</p>

            <label>
                Radius
                @* Text, not number: a number field will not take a comma.
                   inputmode gets the numeric keypad on a phone anyway. *@
                <input type="text" inputmode="decimal" @bind="_radiusText" @bind:event="oninput"
                       @onkeydown="OnKey" autofocus />
                mm
            </label>
            <p class="hint">Komma oder Punkt. Pfeiltasten ↑ ↓ ändern um @RadiusText.Format(RadiusText.Step) mm.</p>

            @if (_error is not null)
            {
                <p class="error">@_error</p>
            }

            <div class="dialog-actions">
                <button @onclick="Cancel">Abbrechen</button>
                <button class="primary" @onclick="Confirm">Verrunden</button>
            </div>
        </div>
    </div>
}
