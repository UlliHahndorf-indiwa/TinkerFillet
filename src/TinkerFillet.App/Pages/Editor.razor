@page "/"
@implements IAsyncDisposable

<PageTitle>TinkerFillet</PageTitle>

<div class="editor" tabindex="0" @onkeydown="OnKeyDown">

    <header class="toolbar">
        <strong>TinkerFillet</strong>

        <label class="file">
            STL laden
            <InputFile OnChange="LoadFile" accept=".stl" />
        </label>

        <label class="slider" title="Ab welchem Winkel zwischen zwei Flächen eine Kante als Kante gilt">
            Kantenwinkel
            <input type="range" min="5" max="90" step="1" value="@_featureAngle"
                   @onchange="OnFeatureAngleChanged" disabled="@(_model is null)" />
            <span>@_featureAngle°</span>
        </label>

        <label class="slider" title="Ab wie vielen Facetten ein Vieleck als Zylinder gilt. Ein Sechskant und ein grob tessellierter Zylinder sind in der Datei nicht zu unterscheiden - hier entscheidest du.">
            Rund ab
            <input type="range" min="4" max="48" step="1" value="@_minimumFacets"
                   @onchange="OnMinimumFacetsChanged" disabled="@(_soup is null)" />
            <span>@_minimumFacets Seiten</span>
        </label>

        <button @onclick="Export" disabled="@(_model is null || _busy)">STL exportieren</button>
    </header>

    <div class="stage">
        <canvas id="viewport" @onmousemove="OnMouseMove" @onclick="OnClick"></canvas>

        @if (_model is null && !_busy)
        {
            <div class="empty">
                <p>STL-Datei laden, Kante anklicken, Radius eingeben.</p>
                <p class="hint">Die Datei bleibt im Browser und wird nirgendwohin übertragen.</p>
            </div>
        }

        <ProgressPanel Visible="_busy" Message="@_busyMessage" Step="_busyStep" Steps="_busySteps" />
    </div>

    <aside class="side">
        @foreach (Note note in _notes)
        {
            <div class="note @note.Severity">@note.Text</div>
        }

        @if (_model is not null)
        {
            <FeatureList Features="_timeline.Features"
                         CanUndo="_timeline.CanUndo"
                         CanRedo="_timeline.CanRedo"
                         RadiusChanged="OnRadiusChanged"
                         Remove="OnRemove"
                         OnUndo="OnUndo"
                         OnRedo="OnRedo" />
        }
    </aside>

    <RadiusDialog Visible="_chain is not null"
                  SegmentCount="_chain?.Count ?? 0"
                  Confirmed="OnRadiusConfirmed"
                  Cancelled="ClearChain" />
</div>
