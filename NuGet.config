<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Bewusst isoliert: <clear /> verwirft alle geerbten Quellen aus der
    Maschinen- und Benutzerkonfiguration.

    Grund 1: Auf dem Entwicklungsrechner sind NuGet-Quellen registriert, die auf
    nicht mehr vorhandene lokale Ordner zeigen (deinstallierte DevExpress-
    Versionen). Die lassen jedes restore mit NU1301 scheitern.

    Grund 2: Reproduzierbarkeit. Das Projekt baut auf macOS und Windows gleich,
    unabhängig davon, was auf dem jeweiligen Rechner sonst noch registriert ist.

    Grund 3: Eine der geerbten Quellen enthält ein Zugangstoken in der URL.
    Ohne <clear /> bestünde die Gefahr, so etwas versehentlich in ein
    öffentliches Repository zu übernehmen.

    Das Projekt braucht ausschließlich nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
